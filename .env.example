# Database (required for analytics and tracking)
DATABASE_URL="postgresql://user:password@localhost:5432/embertext"

# Admin Credentials
# IMPORTANT: Generate a secure password hash using: node -e "console.log(require('crypto').createHmac('sha256', 'your-secret-token-here').update('your-password').digest('hex'))"
# Set ADMIN_USERNAME to your desired username
# Set ADMIN_PASSWORD_HASH to the generated SHA-256 hash
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="generated-hash-here"
NEXT_PUBLIC_ADMIN_SECRET="your-secure-random-string-min-32-chars"

# Groq AI API (FREE TIER - no credit card required)
GROQ_API_KEY=""

# NaraRouter API (FREE TIER - OpenAI compatible)
NARAROUTER_API_KEY=""

# CoinGecko API (OPTIONAL - works without key!)
COINGECKO_API_KEY=""

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
